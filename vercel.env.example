# =============================================================================
# VERCEL FRONTEND ENVIRONMENT VARIABLES
# Paste into: Vercel Project > Settings > Environment Variables
# =============================================================================

# Connect to your Render backend API
# The API helper also accepts the bare host and appends /api automatically.
VITE_API_BASE_URL=https://aeolus-56fx.onrender.com/api

# Optional: MapTiler API Key for vector satellite base maps
VITE_MAPTILER_API_KEY=YOUR_MAPTILER_KEY_HERE
