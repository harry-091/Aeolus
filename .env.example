# =============================================================================
# PolarNav (SIH PS 26059) Backend Environment Configuration Template
# =============================================================================

# 1. SUPABASE POSTGRESQL / POSTGIS DATABASE
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/polarnav
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=polarnav

# 2. SERVER & API CONFIGURATION
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 3. AI NAVIGATION COPILOT (GEMINI & LOCAL FALLBACK)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# 4. COPERNICUS MARINE SERVICE (CMEMS) CREDENTIALS
COPERNICUS_MARINE_USERNAME=YOUR_COPERNICUS_USERNAME
COPERNICUS_MARINE_PASSWORD=YOUR_COPERNICUS_PASSWORD

# 5. NASA EARTHDATA CREDENTIALS (NSIDC / CMR / DAACs)
EARTHDATA_USERNAME=YOUR_EARTHDATA_USERNAME
EARTHDATA_PASSWORD=YOUR_EARTHDATA_PASSWORD

# 6. EXTERNAL SATELLITE & REMOTE SENSING APIS
STAC_API_URL=https://planetarycomputer.microsoft.com/api/stac/v1
PLANETARY_COMPUTER_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1

# 7. METEOROLOGICAL & OCEAN WEATHER APIS
OPEN_METEO_API_KEY=
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1

# 8. NOAA / NSIDC SEA-ICE REPOSITORIES
NOAA_ERDDAP_BASE_URL=https://coastwatch.pfeg.noaa.gov/erddap
NOAA_COASTWATCH_ERDDAP_BASE_URL=https://coastwatch.pfeg.noaa.gov/erddap
NOAA_POLARWATCH_ERDDAP_URL=https://polarwatch.noaa.gov/erddap/griddap
NSIDC_G02135_BASE_URL=https://noaadata.apps.nsidc.org/NOAA/G02135

# 9. AIS MARITIME TRACKING FEED
OPEN_WATERS_BASE_URL=https://ais.openwaters.io/api/v1/vessels
OPEN_WATERS_API_KEY=YOUR_OPEN_WATERS_KEY_HERE

# 10. SHIPBOARD NMEA / GPS TELEMETRY CONFIGURATION
NMEA_ENABLED=false
NMEA_HOST=
NMEA_PORT=10110
NMEA_PROTOCOL=UDP
